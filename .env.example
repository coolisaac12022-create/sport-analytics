# --- Base de données PostgreSQL (fournie automatiquement par Render si tu crées une base "Render Postgres") ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Port du serveur (Render le définit automatiquement, ne pas y toucher en prod) ---
PORT=3000

# --- API sportive ---
# TheSportsDB (gratuite, clé "3" = clé de test publique) : https://www.thesportsdb.com/api.php
SPORTS_API_KEY=3
SPORTS_API_BASE_URL=https://www.thesportsdb.com/api/v1/json

# --- Intelligence Artificielle (optionnel) ---
# Si tu ajoutes une clé Anthropic ici, l'app génère des analyses de matchs en langage naturel.
# Si tu la laisses vide, l'app utilise automatiquement son moteur statistique interne (aucune clé requise).
ANTHROPIC_API_KEY=

# --- Sécurité ---
NODE_ENV=production

# --- Authentification (JWT) ---
# Génère une chaîne longue et aléatoire, ex : openssl rand -hex 32
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# URL publique de ton site une fois déployé (utilisée dans les liens de vérification email)
APP_URL=http://localhost:3000

# Email qui sera automatiquement promu administrateur lors de son inscription.
# Mets ton propre email ici AVANT de t'inscrire la première fois.
ADMIN_EMAIL=admin@exemple.com

# --- Envoi d'emails (vérification email) ---
# Exemple avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, utilise un "mot de passe d'application"
# Si ces variables sont vides, les emails sont simplement affichés dans les logs (pratique en test).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sport Analytics <no-reply@sport-analytics.com>

# --- Envoi de SMS (vérification téléphone) via Twilio ---
# Si ces variables sont vides, le code OTP est simplement affiché dans les logs (pratique en test).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
